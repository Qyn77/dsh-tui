---
import type { Content } from '../i18n';
interface Props { t: Content; }
const { t } = Astro.props;
const { lines, banner, status } = t.terminal;
---
<figure class="demo">
  <div class="term">
    <div class="term-bar">
      <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
      <span class="term-title">dsh-tui</span>
      <span class="preview-label">{t.ui.preview}</span>
    </div>
    <div class="term-body">
      <pre class="banner" aria-hidden="true">{banner}</pre>
      <div class="demo-user">{lines[0]}</div>
      <div class="demo-activity">
        <span class="activity-label">{t.ui.taskLabel}</span>
        {lines.slice(1, 4).map((line) => <div class="line-tool">{line}</div>)}
      </div>
      <div class="demo-result"><span>{t.ui.resultLabel}</span><p>{lines[4]}</p></div>
      <div class="demo-prompt"><span aria-hidden="true">›</span> {t.ui.prompt}</div>
      <div class="term-status">{status.map((chip) => <span>{chip}</span>)}</div>
    </div>
  </div>
  <figcaption>{t.ui.previewTask}</figcaption>
</figure>
