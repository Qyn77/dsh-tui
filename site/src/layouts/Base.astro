---
import '../styles/global.css';
import type { Content } from '../i18n';
import { url } from '../lib/base';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const otherHref = t.lang === 'en' ? url('zh/') : url();
const repo = 'https://github.com/Qyn77/dsh-tui';
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#content">{t.ui.skip}</a>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={url()}>
          <span class="brand-mark" aria-hidden="true">&gt;_</span>
          dsh-tui
        </a>
        <nav class="nav-links" aria-label={t.nav.docs}>
          <a href="#features">{t.nav.features}</a>
          <a href="#commands">{t.nav.commands}</a>
          <a href="#install">{t.nav.install}</a>
          <a href={`${repo}/blob/main/docs/USAGE.md`}>{t.nav.docs}</a>
          <a href={repo}>{t.nav.source}</a>
        </nav>
        <a class="lang" href={otherHref}>{t.otherLabel}</a>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer>
      <div class="wrap footer-inner">
        <div><a class="brand" href={url()}>dsh-tui<span class="footer-arrow" aria-hidden="true">↗</span></a><p>{t.ui.footerNote}</p></div>
        <nav class="footer-links">
          <a href="https://www.npmjs.com/package/@qiao-qyn/dsh-tui">npm</a>
          <a href={`${repo}/blob/main/docs/USAGE.md`}>USAGE</a>
          <a href={`${repo}/blob/main/docs/SPEC.md`}>SPEC</a>
          <a href={`${repo}/blob/main/docs/DEVELOP.md`}>DEVELOP</a>
        </nav>
      </div>
    </footer>

    <script>
      const resetTimers = new WeakMap<HTMLButtonElement, ReturnType<typeof setTimeout>>();
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        button.disabled = false;
      });
      document.addEventListener('click', async (event) => {
        const button = (event.target as HTMLElement)?.closest?.('[data-copy]') as HTMLButtonElement | null;
        if (!button || button.disabled) return;
        const block = button.closest('.command-block')!;
        const label = button.querySelector<HTMLElement>('[data-copy-label]')!;
        const status = block.querySelector<HTMLElement>('[role="status"]')!;
        clearTimeout(resetTimers.get(button));
        button.disabled = true;
        label.textContent = button.dataset.pending!;
        status.textContent = '';
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
          label.textContent = button.dataset.copied!;
          status.textContent = button.dataset.success!;
          button.classList.add('done');
        } catch {
          const code = block.querySelector('code')!;
          const range = document.createRange();
          range.selectNodeContents(code);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
          label.textContent = button.dataset.selected!;
          status.textContent = button.dataset.failure!;
        } finally {
          button.disabled = false;
          resetTimers.set(button, setTimeout(() => {
            label.textContent = button.dataset.idle!;
            button.classList.remove('done');
            status.textContent = '';
          }, 2400));
        }
      });
    </script>
  </body>
</html>
